# Client-safe Expo values.
# These may be embedded in local development and production client bundles.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=replace-with-revenuecat-ios-public-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=replace-with-revenuecat-android-public-key
EXPO_PUBLIC_MIXPANEL_TOKEN=replace-with-mixpanel-project-token
EXPO_PUBLIC_SENTRY_DSN=https://public@sentry.example.invalid/0
EXPO_PUBLIC_APP_ENV=development

# Firebase Auth and Atlas AI. These are public app identifiers, never secrets.
# Register BarkLog as its own Atlas application for the same Firebase project.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_ATLAS_APP_ID=
# Never place Firebase ID/refresh tokens, service-account keys, or provider keys here.
