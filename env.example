# Client-safe Expo values.
# These may be embedded in local development and production client bundles.
# Free v1.0.0 has no subscriptions or ads. Leave RevenueCat keys empty.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Optional observability. Empty values disable the respective service.
EXPO_PUBLIC_MIXPANEL_TOKEN=
EXPO_PUBLIC_SENTRY_DSN=
# Optional GameAnalytics Collection API keys, one game per native platform.
# These client SDK credentials are embedded in the app bundle when configured.
EXPO_PUBLIC_GAMEANALYTICS_ANDROID_GAME_KEY=
EXPO_PUBLIC_GAMEANALYTICS_ANDROID_SECRET_KEY=
EXPO_PUBLIC_GAMEANALYTICS_IOS_GAME_KEY=
EXPO_PUBLIC_GAMEANALYTICS_IOS_SECRET_KEY=
EXPO_PUBLIC_APP_ENV=development

# Firebase Auth and Atlas AI. These are public app identifiers, never secrets.
# Register BarkLog as its own Atlas application for the same Firebase project.
# Firebase Console > Project settings: Web API key and Project ID.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# Atlas > BarkLog application: App ID (UUID). Leave blank until Atlas is configured.
EXPO_PUBLIC_ATLAS_APP_ID=
# Never place Firebase ID/refresh tokens, service-account keys, or provider keys here.
