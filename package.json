{
  "name": "barklog",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.33.0",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "postinstall": "node scripts/ensure-external-pnpm-store-links.js",
    "build:android:debug": "expo run:android",
    "build:android:release": "node scripts/build-android-release.js",
    "build:ios:release": "expo run:ios --configuration Release",
    "clean": "rimraf .expo android coverage ios",
    "lint": "eslint .",
    "format": "eslint --fix . && prettier '**/*.{json,yaml}' --write --ignore-path .gitignore",
    "check-types": "tsc --noEmit --pretty",
    "release:check-env-boundary": "node scripts/check-release-env-boundary.js",
    "release:check-local": "node scripts/run-local-release-gates.js",
    "release:check-native-capabilities": "node scripts/check-native-release-capabilities.js",
    "release:check-production-readiness": "node scripts/check-production-release-readiness.js",
    "tamagui:generate": "tamagui generate",
    "test": "node scripts/run-jest.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-navigation/native": "^7.1.8",
    "@tamagui/config": "2.0.0-rc.41",
    "@tamagui/core": "2.0.0-rc.41",
    "@tamagui/metro-plugin": "2.0.0-rc.41",
    "@tamagui/web": "2.0.0-rc.41",
    "@tanstack/react-query": "^5.100.1",
    "axios": "^1.14.0",
    "expo": "~54.0.34",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "i18next": "^26.0.3",
    "lucide-react-native": "^1.9.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.2",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-mmkv": "^4.3.0",
    "react-native-purchases": "10.0.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tamagui": "2.0.0-rc.41",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.22.9",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@tamagui/babel-plugin": "2.0.0-rc.41",
    "@tamagui/cli": "2.0.0-rc.41",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^12.1.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^8.46.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^8.9.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-jest-formatting": "^3.1.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-testing-library": "^5.11.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.0",
    "react-test-renderer": "19.1.0",
    "rimraf": "^5.0.1",
    "typescript": "~5.9.2"
  }
}
