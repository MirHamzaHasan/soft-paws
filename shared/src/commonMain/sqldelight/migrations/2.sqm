ALTER TABLE dogs ADD COLUMN details_json TEXT NOT NULL DEFAULT '{}';
ALTER TABLE dogs ADD COLUMN revision INTEGER NOT NULL DEFAULT 1;

CREATE TABLE care_events_v3 (
  id TEXT NOT NULL PRIMARY KEY,
  dog_id TEXT NOT NULL REFERENCES dogs(id),
  type TEXT NOT NULL CHECK (type IN ('poop', 'pee', 'meal', 'walk', 'medication', 'symptom', 'mood', 'behavior', 'grooming', 'weight', 'training', 'task')),
  occurred_at INTEGER NOT NULL CHECK (occurred_at >= 0),
  created_at INTEGER NOT NULL CHECK (created_at >= 0),
  note TEXT CHECK (length(note) <= 2000),
  details_json TEXT,
  revision INTEGER NOT NULL DEFAULT 1,
  updated_at INTEGER NOT NULL DEFAULT 0,
  context_json TEXT NOT NULL DEFAULT '{}'
);
INSERT INTO care_events_v3 SELECT *, '{}' FROM care_events;
DROP INDEX events_dog_time;
DROP INDEX events_dog_type_time;
DROP TABLE care_events;
ALTER TABLE care_events_v3 RENAME TO care_events;
CREATE INDEX events_dog_time ON care_events(dog_id, occurred_at DESC, created_at DESC, id DESC);
CREATE INDEX events_dog_type_time ON care_events(dog_id, type, occurred_at DESC);

CREATE TABLE care_items (
  id TEXT NOT NULL PRIMARY KEY,
  dog_id TEXT NOT NULL REFERENCES dogs(id),
  kind TEXT NOT NULL CHECK (kind IN ('medication', 'administration', 'vaccination', 'task', 'completion', 'enrollment', 'session', 'photo', 'expense', 'memory')),
  occurred_at INTEGER NOT NULL CHECK (occurred_at >= 0),
  created_at INTEGER NOT NULL CHECK (created_at >= 0),
  updated_at INTEGER NOT NULL CHECK (updated_at >= 0),
  revision INTEGER NOT NULL DEFAULT 1,
  data_json TEXT NOT NULL CHECK (length(data_json) <= 32768)
);
CREATE INDEX items_dog_kind_time ON care_items(dog_id, kind, occurred_at DESC, id);

CREATE TABLE care_drafts (
  dog_id TEXT NOT NULL REFERENCES dogs(id),
  slot TEXT NOT NULL,
  value_json TEXT NOT NULL CHECK (length(value_json) <= 32768),
  photo_ids_json TEXT NOT NULL DEFAULT '[]',
  PRIMARY KEY (dog_id, slot)
);

CREATE TABLE device_cleanup (
  kind TEXT NOT NULL CHECK (kind IN ('photo', 'reminder')),
  reference TEXT NOT NULL,
  generation INTEGER NOT NULL DEFAULT 1,
  PRIMARY KEY (kind, reference)
);
